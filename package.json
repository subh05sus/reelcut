{
  "name": "reelcut",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn a spoken script into motion-graphics clips, one per beat.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "beats": "tsx skills/reelcut/scripts/beats.ts",
    "intake": "tsx skills/reelcut/scripts/intake.ts",
    "capture": "tsx skills/reelcut/scripts/capture.ts",
    "check-video": "tsx skills/reelcut/scripts/checkVideo.ts",
    "render": "tsx skills/reelcut/scripts/render.ts",
    "sfx:generate": "tsx tools/generate-sfx.ts",
    "archetypes:check": "tsx tools/check-archetypes.ts"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "puppeteer-core": "^25.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
