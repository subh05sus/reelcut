{
  "name": "reelcut",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Turn a spoken script into motion-graphics clips, one per beat.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "beats": "tsx skills/reelcut/scripts/beats.ts",
    "intake": "tsx skills/reelcut/scripts/intake.ts",
    "capture": "tsx skills/reelcut/scripts/capture.ts",
    "check-video": "tsx skills/reelcut/scripts/checkVideo.ts",
    "render": "tsx skills/reelcut/scripts/render.ts",
    "measure": "tsx skills/reelcut/scripts/measure.ts",
    "sfx": "tsx skills/reelcut/scripts/sfx.ts",
    "voice": "tsx skills/reelcut/scripts/voice.ts",
    "footage": "tsx skills/reelcut/scripts/footage.ts",
    "references": "tsx skills/reelcut/scripts/references.ts",
    "generate": "tsx skills/reelcut/scripts/generate.ts",
    "learnings": "tsx skills/reelcut/scripts/learnings.ts",
    "library": "tsx skills/reelcut/scripts/library.ts",
    "studio": "tsx skills/reelcut/scripts/library.ts serve",
    "fonts": "tsx skills/reelcut/scripts/fonts.ts",
    "patterns": "tsx skills/reelcut/scripts/patterns.ts",
    "music": "tsx skills/reelcut/scripts/music.ts",
    "sfx-pack": "tsx skills/reelcut/scripts/sfx-pack.ts",
    "personality": "tsx skills/reelcut/scripts/personality.ts",
    "captions": "tsx skills/reelcut/scripts/captions.ts",
    "performance": "tsx skills/reelcut/scripts/performance.ts",
    "draw": "tsx skills/reelcut/scripts/draw.ts",
    "dashboard": "tsx skills/reelcut/scripts/dashboard.ts",
    "reelcut": "tsx skills/reelcut/scripts/cmd.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.293",
    "@anthropic-ai/sdk": "^0.132.0",
    "puppeteer-core": "^25.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
